# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=healthai_db
DB_USER=healthai
DB_PASSWORD=password

# Spark Configuration
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=2g

# Kaggle API Credentials (required for nutrition, gym_members, body_performance, fitness_tracker pipelines)
# Get your credentials from https://www.kaggle.com/settings/account
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_API_TOKEN=your_kaggle_api_key
